# ─── Database (PostgreSQL / NeonDB Serverless) ──────────────────────────────
# Option A: NeonDB Cloud Serverless PostgreSQL (Recommended for production/cloud)
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Option B: Local PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/geu_alumni

# ─── Application Configuration ──────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_cryptographic_random_string_here
PORT=3001
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:8080

# ─── Cloudinary (File Storage for Documents, Avatars & Resumes) ──────────────
# Required for uploading student ID verification docs during signup, profile avatars, and PDF resumes.
# Get free credentials at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Email (SMTP Server Configuration) ──────────────────────────────────────
# Used to deliver: signup approval credentials, OTP verification codes, and rejection notices.
# NOTE: If left blank or commented out, the server automatically enters Console Fallback Mode
# and prints all emails/OTPs directly in your terminal window (perfect for local development!).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="GEU Alumni Connect <no-reply@geu-alumni.local>"
